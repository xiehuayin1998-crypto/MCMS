
{
  "name": "mc_users",
  "title": "用户管理",
  "schemas": [
    {
      "name": "username",
      "title": "用户名",
      "type": "String"
    },
    {
      "name": "email",
      "title": "邮箱",
      "type": "Email"
    },
    {
      "name": "phone",
      "title": "手机号",
      "type": "String"
    },
    {
      "name": "department",
      "title": "部门",
      "type": "String"
    },
    {
      "name": "position",
      "title": "职位",
      "type": "String"
    },
    {
      "name": "roles",
      "title": "角色",
      "type": "Array",
      "items": {
        "type": "String"
      }
    },
    {
      "name": "roles_level",
      "title": "角色等级",
      "type": "Array",
      "items": {
        "type": "Number"
      }
    },
    {
      "name": "permissions",
      "title": "权限",
      "type": "String"
    },
    {
      "name": "isAdmin",
      "title": "是否管理员",
      "type": "Boolean"
    },
    {
      "name": "avatar",
      "title": "头像",
      "type": "Image"
    },
    {
      "name": "status",
      "title": "状态",
      "type": "String"
    },
    {
      "name": "createdAt",
      "title": "创建时间",
      "type": "DateTime",
      "format": "timestamp-ms"
    },
    {
      "name": "updatedAt",
      "title": "更新时间",
      "type": "DateTime",
      "format": "timestamp-ms"
    }
  ]
}
  